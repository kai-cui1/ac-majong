# 本地开发默认连接（先执行：cd deploy && docker compose up -d）
# 未设置 DATABASE_URL / REDIS_URL 时，服务端自动回退内存实现（单测 / 无 Docker）
DATABASE_URL=mysql://root:root@127.0.0.1:3306/ac_majong
REDIS_URL=redis://127.0.0.1:6379

# WebSocket 网关端口
PORT=8080

# 集成测试开关：设为 1 且提供上面两个 URL 时，persistence.integration.test.ts 才会跑真实库
# DB_IT=1

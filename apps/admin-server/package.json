{
  "name": "@ac-majong/admin-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A&C 麻将 Admin 后台服务端（Fastify 5 + Session/RBAC + Drizzle via persistence；只读查证 + 仲裁留痕）",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ac-majong/engine": "workspace:*",
    "@ac-majong/persistence": "workspace:*",
    "@ac-majong/protocol": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^7.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/session": "^11.1.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}

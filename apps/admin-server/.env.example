# AC 麻将 Admin 后台服务端环境样例（BL-015 / Admin 技术方案 §8）
# 前置：cd deploy && docker compose up -d  然后  pnpm --filter @ac-majong/persistence db:migrate
# 起服：cp .env.example .env  然后  pnpm --filter @ac-majong/admin-server start
#   （经 tsx 起服并由 --env-file-if-exists 自动载入 .env；persistence 导出 TS 源码，故不用 node dist；同 game-server）

# 数据库（admin 仅 MySQL，不回落内存；与 game-server 同库 ac_majong）
DATABASE_URL=mysql://root:root@127.0.0.1:3306/ac_majong

# 会话存储 Redis（缺省则用内存 store，仅 dev/单实例）
REDIS_URL=redis://127.0.0.1:6379

# HTTP 端口（nginx 同源反代 /api → 此端口）
PORT=8090

# @fastify/session 签名密钥，长度必须 ≥ 32（生产用强随机值，勿提交真实值）
SESSION_SECRET=please-change-me-to-a-32+chars-random-secret
# 会话 TTL（秒），默认 8 小时
SESSION_TTL_SEC=28800

# 首个超管 bootstrap：admins 表为空时自动创建（创建后建议改密/停用引导）
ADMIN_BOOTSTRAP_USERNAME=root
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-pass

# 日志级别：silent<error<warn<info<debug<trace
LOG_LEVEL=info

# 安全开关（生产保持 1）：写操作 CSRF 校验 / 登录限流
CSRF_ENABLED=1
RATE_LIMIT_ENABLED=1
# 会话 cookie Secure：1=强制 / 0=关闭 / 缺省=auto（同源 nginx HTTPS 用 auto + trustProxy）
# COOKIE_SECURE=auto

# 集成测试开关：设为 1 且提供 DATABASE_URL（并已 migrate）时，admin 数据层集成测试才跑真实库
# DB_IT=1
